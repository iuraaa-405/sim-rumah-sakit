  <data name="XrLabel64.Text" xml:space="preserve">
    <value>Bila ada satu komponen jawaban “ Ya “ pasang gelang resiko jatuh dan setelah sampai ruangan lakukan asesmen ulang resiko jatuh dengan menggunakan skala morse ( dewasa ) dan humpty dumpty ( anak – anak )</value>
  </data>
  <data name="XrLabel433.Text" xml:space="preserve">
    <value>A = Gizi baik / normal ( skor “ A “ pada &gt; 50 % kategori atau ada peningkatan signifikan
B = Gizi kurang / sedang ( skor “ B “ pada &gt; 50 % kategori
C = Gizi buruk ( skor “ C “ pada &gt; 50 % kategori, tanda tanda fisik signifikan )
</value>
  </data>
