}\levellegal0\levelnorestart0\fi-360\li5040\lin5040}{\listlevel\levelnfc4\levelnfcn4\leveljc0\leveljcn0\levelfollow0\levelstartat1{\leveltext\leveltemplateid67698713 \'02\'07.;}{\levelnumbers\'01;}\levellegal0\levelnorestart0\fi-360\li5760\lin5760}{\listlevel\levelnfc2\levelnfcn2\leveljc2\leveljcn2\levelfollow0\levelstartat1{\leveltext\leveltemplateid67698715 \'02\'08.;}{\levelnumbers\'01;}\levellegal0\levelnorestart0\fi-180\li6480\lin6480}{\listname ;}\listid1562403589}}{\*\listoverridetable {\listoverride\listid1384253491\listoverridecount0\ls10}{\listoverride\listid1612739716\listoverridecount0\ls11}{\listoverride\listid1361471384\listoverridecount0\ls12}{\listoverride\listid1858426398\listoverridecount0\ls13}{\listoverride\listid380792933\listoverridecount0\ls14}{\listoverride\listid799802086\listoverridecount0\ls15}{\listoverride\listid2124110206\listoverridecount0\ls16}{\listoverride\listid165832126\listoverridecount0\ls17}{\listoverride\listid477305176\listoverridecount0\ls18}{\listoverride\listid869731856\listoverridecount0\ls19}{\listoverride\listid609167119\listoverridecount0\ls20}{\listoverride\listid438449027\listoverridecount0\ls21}{\listoverride\listid1562403589\listoverridecount0\ls22}}\nouicompat\splytwnine\htmautsp\sectd\pgwsxn11907\pghsxn16839\psz9{\listtext\pard A.\tab }\pard\plain\ilvl0\ls10\s1\qj\fi-360\li360\lin360\contextualspace{\b\f5\cf0 TANGGUNG JAWAB PASIEN/KELUARGA (}{\b\i\f5\cf0 PATIENT\u8217\'92S RESPONBILITIES}{\b\f5\cf0 )}\b\f5\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls11\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Memberikan informasi yang akurat dan lengkap tentang keluhan sakit sekarang, riwayat medis yang lalu, riwayat medikasi/pengobatan dan hal-hal lain yang berkaitan dengan kesehatan pasien.}\f5\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls11\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Memperlakukan staf RS dan pasien lain dengan bermartabat dan hormat serta tidak melakukan tindakan yang mengganggu pekerjaan tenaga RS.}\f5\par{\listtext\pard 3.\tab }\pard\plain\ilvl0\ls11\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Menghormati privasi orang lain dan barang milik RS.}\f5\par{\listtext\pard 4.\tab }\pard\plain\ilvl0\ls11\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Tidak membawa alkohol, obat-obat yang tidak mendapat persetujuan, senjata/benda tajam ke dalam RS.}\f5\par{\listtext\pard 5.\tab }\pard\plain\ilvl0\ls11\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Tidak membawa barang berharga dan hanya membawa barang-barang yang dibutuhkan selama di RS.}\f5\par{\listtext\pard 6.\tab }\pard\plain\ilvl0\ls11\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Memastikan bahwa kewajiban finansial atas asuhan pasien dipenuhi sebagaimana ketentuan RS.}\f5\par{\listtext\pard 7.\tab }\pard\plain\ilvl0\ls11\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Bertanggung jawab atas tindakannya sendiri bila menolak pengobatan atau saran dokter. }\f5\par{\listtext\pard 8.\tab }\pard\plain\ilvl0\ls11\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Mengikuti rencana pengobatan yang di adviskan oleh dokter termasuk instruksi para perawat dan profesional kesehatan lain sesuai perintah dokter.}\f5\par\pard\plain\qj\contextualspace\f5\fs22\par{\listtext\pard B.\tab }\pard\plain\ilvl0\ls10\s1\qj\fi-360\li360\lin360\contextualspace{\b\f5\cf0 PELEPASAN INFORMASI (}{\b\i\f5\cf0 RELEASE OF INFORMATION}{\b\f5\cf0 ) }\b\f5\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls12\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya memahami informasi yang ada didalam diri saya termasuk diagnosis, hasil laboratorium dan hasil test diagnostik yang akan digunakan untuk perawatan medis, RS akan menjamin kerahasiaannya. }\f5\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls12\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya memberi wewenang kepada RS untuk memberikan informasi tentang diagnosis, hasil pelayanan dan pengobatan bila diperlukan untuk memproses klaim asuransi/perusahaan dan atau lembaga pemerintah. }\f5\par{\listtext\pard 3.\tab }\pard\plain\ilvl0\ls12\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya memberi wewenang kepada RS untuk memberikan informasi tentang diagnosis, hasil pelayanan dan pengobatan saya kepada:}\f5\par{\listtext\pard \u183\'b7\tab }\pard\plain\ilvl0\ls13\s1\qj\fi-360\li1080\lin1080\contextualspace{\f5\cf0 \u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85..}\f5\par{\listtext\pard \u183\'b7\tab }\pard\plain\ilvl0\ls13\s1\qj\fi-360\li1080\lin1080\contextualspace{\f5\cf0 \u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85..}\b\f5\par\pard\plain\s1\qj\li1077\lin1077\contextualspace\f5\par{\listtext\pard C.\tab }\pard\plain\ilvl0\ls10\s1\qj\fi-360\li360\lin360\contextualspace{\b\f5\cf0 KEINGINAN PRIVASI (}{\b\i\f5\cf0 DESIRE PRIVACY}{\b\f5\cf0 )  }\b\f5\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls14\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Pasien dapat ditunggu oleh 1 orang anggota keluarga, apabila di butuhkan lebih dari 1 penunggu harus ada persetujuan dari petugas ruangan.}\f5\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls14\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya mengijinkan RS memberi akses bagi keluarga dan handai taulan serta orang-orang yang akan menengok saya kecuali kepada : }\f5\par{\listtext\pard \u183\'b7\tab }\pard\plain\ilvl0\ls15\s1\qj\fi-360\li1080\lin1080\contextualspace{\f5\cf0 \u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85.}\f5\par{\listtext\pard \u183\'b7\tab }\pard\plain\ilvl0\ls15\s1\qj\fi-360\li1080\lin1080\contextualspace{\f5\cf0 \u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85. }\f5\par\pard\plain\s1\qj\li1077\lin1077\f5\par{\listtext\pard D.\tab }\pard\plain\ilvl0\ls10\s1\qj\fi-360\li360\lin360\contextualspace{\b\f5\cf0 BARANG BERHARGA MILIK PRIBADI (}{\b\i\f5\cf0 WHORTY OF PERSONAL}{\b\f5\cf0 )}\b\f5\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls16\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya telah memahami bahwa RS tidak bertanggung jawab atas semua kehilangan barang-barang milik saya, dan saya pribadi bertanggung jawab atas barang\u8211\'96barang berharga yang saya bawa ke RS kecuali di titipkan ke RS.}\f5\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls16\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Barang berharga yang dapat dititipkan ke RS adalah uang dan dokumen yang berhubungan dengan proses perawatan di RS.}\f5\par\pard\plain\qj\contextualspace\f5\fs22\par{\listtext\pard E.\tab }\pard\plain\ilvl0\ls10\s1\qj\fi-360\li360\lin360\contextualspace{\b\f5\cf0 PERNYATAAN PASIEN (}{\b\i\f5\cf0 STATEMENT OF PATIENT}{\b\f5\cf0 )  }\b\f5\par\pard\plain\s1\qj\li360\lin360\contextualspace{\f5\cf0 Saya mengerti dan memahami bahwa :}\f5\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya memiliki hak untuk mengajukan pertanyaan tentang pengobatan yang diusulkan (termasuk identitas setiap orang yang memberikan atau mengamati pengobatan) setiap saat.}\f5\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya mengerti dan memahami bahwa memiliki hak untuk menyetujui, atau menolak setiap prosedur/terapi}\f5\par{\listtext\pard 3.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya mengerti bahwa banyak dokter dan paramedik RS yang bukan karyawan tetapi staf independen/tamu yang telah diberikan hak untuk menggunakan fasilitas untuk perawatan dan pengobatan pasien mereka.}\f5\par{\listtext\pard 4.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Jika diperlukan, saya bersedia mematuhi aturan RS tentang dokter yang bertanggung jawab untuk perawatan saya selama dalam perawatan RS.}\f5\par\pard\plain\s1\qj\li720\lin720\contextualspace\f5\par\pard\plain\s1\qj\li720\lin720\contextualspace\f5\par\pard\plain\s1\qj\li720\lin720\contextualspace\f5\par\pard\plain\s1\qj\li720\lin720\contextualspace\f5\par{\listtext\pard 5.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Bila diperlukan untuk kelengkapan data dan informasi, saya bersedia untuk dokumentasi media visual.}\f5\par{\listtext\pard 6.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya mengerti bahwa banyak mahasiswa yang diberikan izin untuk melaksanakan praktek kerja lapangan}\f5\par{\listtext\pard 7.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya sudah membaca/memahami hak dan kewajiban pasien di RS Dustira, apabila membutuhkan informasi tambahan saya akan menghubungi staf rumah sakit.}\f5\par{\listtext\pard 8.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Jika ada komplain saya bersedia mengikuti alur penanganan komplain pasien di RS Dustira.}\f5\par{\listtext\pard 9.\tab }\pard\plain\ilvl0\ls17\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya bersedia mematuhi tata-tertib peraturan yang ada di RS Dustira}\f5\par\pard\plain\s1\qj\li720\lin720\contextualspace\f5\par{\listtext\pard F.\tab }\pard\plain\ilvl0\ls10\s1\qj\fi-360\li360\lin360\contextualspace{\b\f5\cf0 PERSETUJUAN UNTUK PENGOBATAN (}{\b\i\f5\cf0 CONSENT FOR TREATMENT}{\b\f5\cf0 )     }\b\f5\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls18\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya mengetahui bahwa saya memiliki kondisi yang membutuhkan perawatan medis, saya mengizinkan dokter dan profesional kesehatan lainnya untuk melakukan prosedur diagnostik dan untuk memberikan pengobatan medis seperti yang diperlukan dalam penilaian profesional mereka. Prosedur diagnostik dan perawatan medis tidak terbatas pada elektrokardiogram, X-ray, tes darah terapi fisik, pemberian obat, tindakan medis infus, NGT serta pemasangan kateter.}\f5\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls18\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Saya sadar bahwa praktik kedokteran dan bedah bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun, terhadap perawatan prosedur atau pemeriksaan apapun yang dilakukan kepada saya.}\f5\par{\listtext\pard 3.\tab }\pard\plain\ilvl0\ls18\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Apabila saya terlibat dalam penelitian atau prosedur eksperimental, maka hal tersebut hanya dapat dilakukan dengan sepengetahuan dan persetujuan saya.}\f5\par{\listtext\pard 4.\tab }\pard\plain\ilvl0\ls18\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Pasien yang pulang tanpa seizin dokter dinyatakan pulang paksa dan diwajibkan membuat surat penolakan di rawat.}\f5\par\pard\plain\s1\qj\li720\lin720\contextualspace\f5\par{\listtext\pard G.\tab }\pard\plain\ilvl0\ls10\s1\ql\fi-360\li360\lin360\contextualspace\sa200{\lang1033\langfe1033\b\f5\cf0 HAK PASIEN :}\lang1033\langfe1033\b\f5\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls19\qj\fi-142\li426\lin426\sbauto1\saauto1\tx709{\f5\fs22\cf0 Memperoleh informasi mengenai tata tertib dan peraturan yang berlaku di Rumah Sakit;}\f5\fs22\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls19\qj\fi-142\li426\lin426\sbauto1\saauto1\tx709{\f5\fs22\cf0 Memperoleh informasi tentang hak dan kewajiban pasien;}\f5\fs22\par{\listtext\pard 3.\tab }\pard\plain\ilvl0\ls19\qj\fi-142\li426\lin426\sbauto1\saauto1\tx709{\f5\fs22\cf0 Memperoleh layanan yang manusiawi, adil, jujur, dan tanpa diskriminasi;}\f5\fs22\par{\listtext\pard 4.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx709{\f5\fs22\cf0 Memperoleh layanan kesehatan yang bermutu sesuai dengan standar profesi dan standar prosedur operasional;}\f5\fs22\par{\listtext\pard 5.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx709{\f5\fs22\cf0 Memperoleh layanan yang efektif dan efisien sehingga pasien terhindar dari kerugian fisik dan materi;}\f5\fs22\par{\listtext\pard 6.\tab }\pard\plain\ilvl0\ls19\qj\fi-142\li426\lin426\sbauto1\saauto1\tx709{\f5\fs22\cf0 Mengajukan pengaduan atas kualitas pelayanan yang didapatkan;}\f5\fs22\par{\listtext\pard 7.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx786{\f5\fs22\cf0 Memilih dokter dan kelas perawatan sesuai dengan keinginannya dan peraturan yang berlaku di Rumah Sakit;}\f5\fs22\par{\listtext\pard 8.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx709{\f5\fs22\cf0 Meminta konsultasi tentang penyakit yang dideritanya kepada dokter lain yang mempunyai Surat Izin Praktik (SIP) baik di dalam maupun di luar Rumah Sakit;}\f5\fs22\par{\listtext\pard 9.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx709{\f5\fs22\cf0 Mendapatkan privasi dan kerahasiaan penyakit yang diderita termasuk data-data medisnya;}\f5\fs22\par{\listtext\pard 10.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx786{\f5\fs22\cf0 Mendapat informasi yang meliputi diagnosis dan tata cara tindakan medis, tujuan tindakan medis, alternatif tindakan, risiko dan komplikasi yang mungkin terjadi, dan prognosis terhadap tindakan yang dilakukan serta perkiraan biaya pengobatan;}\f5\fs22\par{\listtext\pard 11.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx786{\f5\fs22\cf0 Memberikan persetujuan atau menolak atas tindakan yang akan dilakukan oleh tenaga kesehatan terhadap penyakit yang dideritanya;}\f5\fs22\par{\listtext\pard 12.\tab }\pard\plain\ilvl0\ls19\qj\fi-142\li426\lin426\sbauto1\saauto1\tx709{\f5\fs22\cf0 Didampingi keluarganya dalam keadaan kritis;}\f5\fs22\par{\listtext\pard 13.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx709{\f5\fs22\cf0 Menjalankan ibadah sesuai agama atau kepercayaan yang dianutnya selama hal itu tidak mengganggu pasien lainnya;}\f5\fs22\par{\listtext\pard 14.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx786{\f5\fs22\cf0 Memperoleh keamanan dan keselamatan dirinya selama dalam perawatan di Rumah Sakit;}\f5\fs22\par{\listtext\pard 15.\tab }\pard\plain\ilvl0\ls19\qj\fi-142\li426\lin426\sbauto1\saauto1\tx709{\f5\fs22\cf0 Mengajukan usul, saran, perbaikan atas perlakuan Rumah Sakit terhadap dirinya;}\f5\fs22\par{\listtext\pard 16.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx709{\f5\fs22\cf0 Menolak pelayanan bimbingan rohani yang tidak sesuai dengan agama dan kepercayaan yang dianutnya;}\f5\fs22\par{\listtext\pard 17.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx709{\f5\fs22\cf0 Menggugat dan/atau menuntut Rumah Sakit apabila Rumah Sakit diduga memberikan pelayanan yang tidak sesuai dengan standar baik secara perdata ataupun pidana; dan}\f5\fs22\par{\listtext\pard 18.\tab }\pard\plain\ilvl0\ls19\qj\fi-425\li709\lin709\sbauto1\saauto1\tx786{\f5\fs22\cf0 Mengeluhkan pelayanan Rumah Sakit yang tidak sesuai dengan standar pelayanan melalui media cetak dan elektronik sesuai dengan ketentuan peraturan perundang-undangan.}\f5\fs22\par\pard\plain\qj\f5\fs22\par\pard\plain\s1\qj\li720\lin720\contextualspace\f5\par\pard\plain\qj\li360\lin360\contextualspace\f5\fs22\par\pard\plain\qj\li360\lin360\contextualspace\f5\fs22\par{\listtext\pard H.\tab }\pard\plain\ilvl0\ls20\s1\qj\fi-426\li426\lin426\contextualspace\sl360\slmult1{\b\f5\cf0 TATA TERTIB PENGUNJUNG RUMAH SAKIT TK. II 03.05.01 DUSTIRA}\f5\par\pard\plain\qc\b\f5\fs22\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Jam berkunjung }\f5\fs22\par{\listtext\pard a.\tab }\pard\plain\ilvl1\ls19\qj\fi-284\li993\lin993\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Pagi   pukul    :   10.00 -  12 WIB}\f5\fs22\par{\listtext\pard b.\tab }\pard\plain\ilvl1\ls19\qj\fi-284\li993\lin993\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Sore Pukul      : 16.00 -     18.00}\f5\fs22\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Sesudah jam berkunjung, harap segera meninggalkan ruangan.}\f5\fs22\par{\listtext\pard 3.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Pasien dapat di tunggu oleh satu orang anggota keluarga terdekat dan mengurus Kartu Penunggu Pasien ke petugas ruang perawatan setempat.}\f5\fs22\par{\listtext\pard 4.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Apabila penunggu pasien dibutuhkan lebih dari 1 (satu) orang dan atas pertimbangan petugas ruangan maka keluarga dapat mengurus surat ijin menunggu dan akan mendapatkan kartu tunggu dari petugas.}\f5\fs22\par{\listtext\pard 5.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Kartu Penunggu Pasien berlaku untuk 1 (satu) orang.}\f5\fs22\par{\listtext\pard 6.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Tidak membawa senjata api dan senjata tajam.}\f5\fs22\par{\listtext\pard 7.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Tidak membawa anak kecil dibawah umur 12 tahun masuk ke ruang perawatan.}\f5\fs22\par{\listtext\pard 8.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Tidak Ramai, Gaduh, dan Ribut}{\lang1033\langfe1033\f5\fs22\cf0 .}\f5\fs22\par{\listtext\pard 9.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Tidak membawa barang berharga dan atau uang dalam jumlah besar.}\f5\fs22\par{\listtext\pard 10.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Dilarang bermain di ruangan/ taman sesudah jam berkunjung selesai.}\f5\fs22\par{\listtext\pard 11.\tab }\pard\plain\ilvl0\ls21\qj\fi-360\li720\lin720\contextualspace\sbauto1\saauto1\sl360\slmult1{\f5\fs22\cf0 Dilarang merokok di seluruh area Rumah Sakit.}\f5\fs22\par\pard\plain\qj\li360\lin360\sl360\slmult1\f5\fs22\par\pard\plain\qj\li360\lin360\contextualspace{\f5\fs22\cf0 Demikian saya atas nama pasien  \u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85\u8230\'85. telah membaca serta memahami surat persetujuan umum ini, Saya bersedia memenuhi ketentuan persetujuan tersebut di atas dan apabila saya melanggar ketentuan tersebut, maka siap menerima sangsi sesuai ketentuan yang berlaku di RS Dustira, berupa :}\f5\fs22\par{\listtext\pard 1.\tab }\pard\plain\ilvl0\ls22\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Teguran Lisan}\f5\par{\listtext\pard 2.\tab }\pard\plain\ilvl0\ls22\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Teguran tertulis berupa pernyataan }\f1\par{\listtext\pard 3.\tab }\pard\plain\ilvl0\ls22\s1\qj\fi-360\li720\lin720\contextualspace{\f5\cf0 Penarikan pengaduan apabila saya menyampaikan komplain langsung  kepada Media Massa/tidak sesuai prosedur RS Dustira}\f1\par}"
        End If
    End Sub
    Private Sub fn_LoadData()
        Try
            Dim dsDetail_1 = oDigital.GetData(sNoId)
            With dsDetail_1
                'txtMEMO.RtfText = .MEMO_01
                'txtMEMO.Text = .MEMO_02

                txtKDREG.Text = .KDKUNJUNGAN
                txtRM.Text = .R_IDENTITAS_PASIEN.KDCUSTOMER
                txtNAMAPASIEN.Text = .R_IDENTITAS_PASIEN.NAMAPASIEN.ToString.Trim.ToUpper
                deDATELAHIRPASIEN.DateTime = .R_IDENTITAS_PASIEN.TANGGALLAHIR

                If .R_IDENTITAS_PASIEN.JENISKELAMIN = "L" Then
                    cboJKPasien.SelectedIndex = 0
                Else
                    cboJKPasien.SelectedIndex = 1
                End If


                txtKDSIGNATURE.Text = .KDUSER_SIGNATURE

            End With

        Catch oErr As Exception
            MsgBox("Load List Data : " & vbCrLf & oErr.Message, MsgBoxStyle.Exclamation, Me.Text)
        End Try
    End Sub
    Private Function fn_Validate() As Boolean
        Try
            fn_Validate = True
            If txtKDREG.Text = String.Empty Then
                MsgBox("Dibutuhkan KDREG", MsgBoxStyle.Exclamation, Me.Text)
                txtKDREG.Focus()
                fn_Validate = False
                Exit Function
            End If
            If txtKDSIGNATURE.Text = String.Empty Then
                MsgBox("Dibutuhkan KDSIGNATURE", MsgBoxStyle.Exclamation, Me.Text)
                txtKDSIGNATURE.Focus()
                fn_Validate = False
                Exit Function
            End If

        Catch oErr As Exception
            MsgBox("Validate Data : " & vbCrLf & oErr.Message, MsgBoxStyle.Exclamation, Me.Text)
        End Try
    End Function
    Private Function fn_Save() As Boolean
        Try
            Dim ds_1 = oDigital.GetStructureHeader

            With ds_1
                .KDKUNJUNGAN = sNoId
                Try
                    .DATECREATED = oDigital.GetData(txtKDREG.Text).DATECREATED
                Catch ex As Exception
                    .DATECREATED = Now
                End Try
                .DATEUPDATED = Now
                '.MEMO_01 = txtMEMO.RtfText
                '.MEMO_02 = txtMEMO.Text
                .MEMO_03 = ""
                .MEMO_04 = ""
                Try
                    .CETAK = oDigital.GetData(sNoId).CETAK
                Catch ex As Exception
                    .CETAK = 0
                End Try
                .KDUSER = sUserID
                .KDUSER_SIGNATURE = sUserSIGNATURE
            End With

            If oFormMode = FORM_MODE.FORM_MODE_ADD Then
                Try
                    fn_Save = oDigital.InsertData(ds_1, txtKDSIGNATURE.Text)
                Catch ex As Exception
                    MsgBox("Simpan Data : " & vbCrLf & ex.Message, MsgBoxStyle.Exclamation, Me.Text)
                End Try
            ElseIf oFormMode = FORM_MODE.FORM_MODE_EDIT Then
                Try
                    fn_Save = oDigital.UpdateData(ds_1, txtKDSIGNATURE.Text)
                Catch ex As Exception
                    MsgBox("Simpan Data : " & vbCrLf & ex.Message, MsgBoxStyle.Exclamation, Me.Text)
                End Try
            End If

        Catch oErr As Exception
            MsgBox("Simpan Data : " & vbCrLf & oErr.Message, MsgBoxStyle.Exclamation, Me.Text)
            fn_Save = False
        End Try
    End Function
#End Region
#Region "Command Button"
    Private Sub frmItem_KeyDown(ByVal sender As System.Object, ByVal e As System.Windows.Forms.KeyEventArgs) Handles MyBase.KeyDown
        Select Case e.KeyCode
            Case Keys.F12
                btnClose_Click()
            Case Keys.F2
                If btnSaveNew.Enabled = True Then
                    btnSaveNew_Click()
                End If
            Case Keys.F3
                If btnSaveClose.Enabled = True Then
                    btnSaveClose_Click()
                End If
            Case Keys.F5
                If btnSidikJari.Enabled = True Then
                    btnSidikJari_Click()
                End If
        End Select
    End Sub
    Private Sub btnSidikJari_Click() Handles btnSidikJari.ItemClick

    End Sub
    Private Sub btnSaveNew_Click() Handles btnSaveNew.ItemClick
        If fn_Validate() = False Then Exit Sub
        If MsgBox("Save " & txtKDREG.Text.Trim.ToUpper & "?", MsgBoxStyle.Exclamation + MsgBoxStyle.YesNo, Me.Text) = MsgBoxResult.No Then Exit Sub
        If fn_Save() = False Then
            MsgBox("Save gagal! Tolong kontak admin anda!", MsgBoxStyle.Exclamation, Me.Text)
        Else
            MsgBox("Save " & txtKDREG.Text.Trim.ToUpper & " success!", MsgBoxStyle.Information, Me.Text)
            Me.Close()
        End If
    End Sub
    Private Sub btnSaveClose_Click() Handles btnSaveClose.ItemClick
        If fn_Validate() = False Then Exit Sub
        If MsgBox("Save " & txtKDREG.Text.Trim.ToUpper & "?", MsgBoxStyle.Exclamation + MsgBoxStyle.YesNo, Me.Text) = MsgBoxResult.No Then Exit Sub
        If fn_Save() = False Then
            MsgBox("Save gagal! Tolong kontak admin anda!", MsgBoxStyle.Exclamation, Me.Text)
        Else
            MsgBox("Save " & txtKDREG.Text.Trim.ToUpper & " success!", MsgBoxStyle.Information, Me.Text)
            Me.Close()
        End If
    End Sub
    Private Sub btnClose_Click() Handles btnClose.ItemClick
        Me.Close()
    End Sub
